{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "mobile:configure": "node scripts/configure-mobile.js",
        "mobile:build": "npm run mobile:configure && vite build --config vite.mobile.config.js && node scripts/copy-mobile-config.js",
        "android:sync": "npm run mobile:build && cap sync android",
        "android:open": "cap open android"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.6.2",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@capacitor/android": "^8.6.2",
        "@capacitor/core": "^8.6.2",
        "@capacitor/push-notifications": "^8.1.3",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8"
    }
}
